# Runtime
NODE_ENV=development
TZ=Asia/Seoul
APP_NAME=시그널랩
API_PORT=3000
API_BASE_URL=http://localhost:3000/v1
API_CORS_ORIGINS=http://localhost:8081,http://localhost:19006
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Supabase local defaults. Replace with values printed by `supabase start`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
DATABASE_URL=jdbc:postgresql://127.0.0.1:54322/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# AI signal explanation. Server-side only; never use an EXPO_PUBLIC_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Worker
# Leave blank for one-shot local Worker. Set only when Redis runs.
REDIS_URL=
WORKER_SERVICE_TOKEN=local-worker-change-me
WORKER_ENABLED=false
WORKER_DAILY_CYCLE_ENABLED=false
WORKER_MARKET_DATA_AUTO_ENABLED=false
WORKER_MARKET_DATA_AUTO_BATCH_SIZE=10
# 일반 Worker가 시작 5초 후 확인하고, 이후 5분마다 고정 KOSPI TOP10의 최신 완료 거래일 일봉만 점검합니다.
WORKER_MARKET_DATA_AUTO_INITIAL_DELAY_MS=5000
WORKER_MARKET_DATA_AUTO_INTERVAL_MS=300000
WORKER_TASK_MAX_RETRIES=3
WORKER_TASK_RETRY_DELAY_MS=500
WORKER_SCHEDULER_POOL_SIZE=8
WORKER_SHUTDOWN_TIMEOUT=10s
# 로컬에서만 true. KOSPI TOP10 + 지표 시나리오 합성 20종목 유니버스 편집 API를 엽니다.
SIGNAL_TEST_FIXTURE_ENABLED=false
WORKER_SELL_CYCLE_ENABLED=false
MARKET_DATA_PROVIDER=kiwoom
MARKET_DATA_UNIVERSE_VERSION_ID=uv-kr-all-v1
MARKET_CALENDAR_VERSION=krx-provisional-2023-2026-v1
# Comma-separated exchange holiday data. Verify against KRX before production.
MARKET_CALENDAR_HOLIDAYS=2023-09-28,2023-09-29,2023-10-02,2023-10-03,2023-10-09,2023-12-25,2023-12-29,2024-01-01,2024-02-09,2024-02-12,2024-03-01,2024-04-10,2024-05-01,2024-05-06,2024-05-15,2024-06-06,2024-08-15,2024-09-16,2024-09-17,2024-09-18,2024-10-03,2024-10-09,2024-12-25,2024-12-31,2025-01-01,2025-01-27,2025-01-28,2025-01-29,2025-01-30,2025-03-03,2025-05-01,2025-05-05,2025-05-06,2025-06-03,2025-06-06,2025-08-15,2025-10-03,2025-10-06,2025-10-07,2025-10-08,2025-10-09,2025-12-25,2025-12-31,2026-01-01,2026-02-16,2026-02-17,2026-02-18,2026-03-02,2026-05-01,2026-05-05,2026-05-25,2026-06-03,2026-08-17
MARKET_CALENDAR_EXTRA_SESSIONS=
MARKET_CALENDAR_FROM=
MARKET_CALENDAR_THROUGH=

# Push stays local until credentials exist.
PUSH_PROVIDER=console
EXPO_ACCESS_TOKEN=

# Kiwoom OpenAPI secrets stay server-side. Never put these in EXPO_PUBLIC_*.
KIWOOM_MODE=demo
KIWOOM_API_BASE_URL=
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_APP_KEY_DEMO=
KIWOOM_APP_SECRET_DEMO=
KIWOOM_MAX_PAGES=30
KIWOOM_MASTER_API_ID=ka10099
KIWOOM_MASTER_PATH=/api/dostk/stkinfo
KIWOOM_MASTER_MARKETS=0:KOSPI,10:KOSDAQ
# Market data import/backfill. Safe to set before Kiwoom key arrives.
MARKET_DATA_UNIVERSE_EFFECTIVE_FROM=2026-08-01
MARKET_DATA_UNIVERSE_SOURCE_REVISION=
BACKFILL_YEARS=3
BACKFILL_CHUNK_DAYS=180
BACKFILL_REQUEST_DELAY_MS=250
BACKFILL_MAX_RETRIES=3
BACKFILL_MAX_INSTRUMENTS=
BACKFILL_SYMBOLS=
BACKFILL_MARKETS=KOSPI,KOSDAQ
BACKFILL_DRY_RUN=false
