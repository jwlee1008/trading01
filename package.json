{
  "name": "stock-signal-mvp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm build:packages && node scripts/run-dev.mjs",
    "dev:api": "node --env-file=.env scripts/run-backend.mjs api bootRun",
    "dev:worker": "node --env-file=.env scripts/run-backend.mjs worker bootRun",
    "dev:mobile": "pnpm --filter @signal/mobile dev",
    "env:check": "node --env-file-if-exists=.env scripts/validate-env.mjs",
    "worker:admin": "node --env-file-if-exists=.env scripts/worker-admin.mjs",
    "worker:import:calendar": "node --env-file=.env scripts/run-backend.mjs worker importCalendar",
    "worker:import:instruments": "node --env-file=.env scripts/run-backend.mjs worker importInstruments",
    "worker:refresh:kospi-top10": "node --env-file=.env scripts/run-backend.mjs worker refreshKospiTop10",
    "worker:backfill:candles": "node --env-file=.env scripts/run-backend.mjs worker backfillCandles",
    "worker:backfill:kospi-top10": "node --env-file=.env scripts/run-backend.mjs worker backfillKospiTop10",
    "worker:prepare:market-data": "node --env-file=.env scripts/run-backend.mjs worker prepareMarketData",
    "worker:benchmark": "node --env-file=.env scripts/run-backend.mjs worker benchmark",
    "build": "pnpm -r --if-present build",
    "build:packages": "pnpm --filter './packages/**' --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:run": "pnpm -r --if-present test:run",
    "check": "pnpm lint && pnpm typecheck && pnpm test:run",
    "check:expo": "pnpm --filter @signal/mobile exec expo install --check",
    "check:peers": "pnpm peers check",
    "check:audit": "pnpm audit --audit-level=moderate",
    "check:web": "pnpm --filter @signal/mobile exec expo export --platform web --output-dir dist",
    "check:release": "pnpm check && pnpm build && pnpm check:expo && pnpm check:peers && pnpm check:web && pnpm check:audit",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "dev:spring-api": "pnpm dev:api",
    "check:spring-api": "node --env-file=.env scripts/run-backend.mjs api check",
    "dev:spring-worker": "pnpm dev:worker",
    "spring-worker:once": "node --env-file=.env scripts/run-backend.mjs worker once",
    "check:spring-worker": "node --env-file=.env scripts/run-backend.mjs worker check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.3.0",
    "eslint": "10.8.1",
    "supabase": "^2.114.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
